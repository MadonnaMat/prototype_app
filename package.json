{
  "name": "app",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/dev-server": "^2.0.0",
    "@rspack/plugin-react-refresh": "^2.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30",
    "@types/prop-types": "^15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-refresh": "^0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "react-refresh": "^0.18.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "bin/shakapacker",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "quality": "knip",
    "complexity": "eslint --config eslint.config.complexity.mjs app/javascript",
    "build:css": "tailwindcss -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "build:test": "RAILS_ENV=test NODE_ENV=test bin/shakapacker-precompile-hook && SHAKAPACKER_SKIP_PRECOMPILE_HOOK=true RAILS_ENV=test NODE_ENV=test bin/shakapacker"
  },
  "dependencies": {
    "@rspack/cli": "^2.0.0",
    "@rspack/core": "^2.0.0-0",
    "@swc/core": "^1.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "compression-webpack-plugin": "^12.0.0",
    "css-loader": "^7.0.0",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.0.0",
    "prop-types": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-on-rails": "17.0.0",
    "rspack-manifest-plugin": "^5.0.0",
    "sass": "^1.50.0",
    "sass-loader": "^16.0.0",
    "shadcn": "^4.16.2",
    "shakapacker": "10.3.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "version": "0.1.0",
  "browserslist": [
    "defaults"
  ]
}
